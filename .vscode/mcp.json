{
  "servers": {
    "obsidian-vault": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/dist/index.js"],
      "cwd": "${workspaceFolder}",
      "env": {
        "OBSIDIAN_VAULT_PATH": "${input:obsidianVaultPath}"
      }
    }
  },
  "inputs": [
    {
      "id": "obsidianVaultPath",
      "type": "promptString",
      "description": "Absolute path to your Obsidian vault",
      "password": false
    }
  ]
}
